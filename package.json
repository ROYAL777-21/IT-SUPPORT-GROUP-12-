{
  "name": "campus-it-help",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "bundle:check": "expo export --platform android --output-dir .expo-bundle-check",
    "doctor": "expo-doctor",
    "grant-support": "node scripts/grant-support.mjs",
    "start": "expo start --dev-client",
    "test:rules": "firebase emulators:exec --only firestore --project demo-campus-it-help \"node --test tests/firestore-rules.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:release": "node scripts/check-release.mjs",
    "prebuild:android": "npm run verify:release && expo prebuild --platform android --no-install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "babel-preset-expo": "~57.0.7",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.0",
    "expo-doctor": "1.21.5",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "15.34.0",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "decode-uri-component": "0.5.0",
    "xcode": {
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
