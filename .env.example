# Optional: copy to .env if the Android client file is stored elsewhere.
# Download this file from Firebase project it-support-eduvos for Android
# package za.ac.eduvos.campusithelp. It is ignored by Git.
GOOGLE_SERVICES_JSON=./google-services.json

# Microsoft uses the organizations endpoint and your own app registration.
# No Eduvos tenant ID is needed. Enter the Microsoft Application (client) ID
# and secret Value only in Firebase Authentication's Microsoft settings.
# Never put the client secret or a service-account key in this file or the app.
