{
  "name": "campus-it-help",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "bundle:check": "expo export --platform android --output-dir .expo-bundle-check",
    "doctor": "expo-doctor",
    "grant-support": "node scripts/grant-support.mjs",
    "start": "expo start --dev-client",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project campus-it-help-rules-test \"node --test tests/firestore-rules.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "test:migrations": "node --test tests/migration-v3.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/auth": "^26.3.2",
    "@react-native-firebase/firestore": "^26.3.2",
    "babel-preset-expo": "~57.0.7",
    "expo": "^57.0.15",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "typescript": "~5.9.2"
  }
}
