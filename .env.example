# Copy to .env and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
#
# The EXPO_PUBLIC_ prefix is required — Expo only inlines env vars with that prefix
# into the client bundle. These values are shipped to the device and are NOT secret;
# Firebase security rules are what actually protect the data, not this config.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
