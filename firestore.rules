rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function institutional() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('[^@\\s]+@(vossie[.]net|eduvos[.]com)$');
    }
    function support() {
      return institutional() && request.auth.token.get('support', false) == true;
    }
    function text(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function optionalText(data, field, maximum) {
      return data.get(field, null) == null || text(data[field], 0, maximum);
    }
    function validTicket(d, id) {
      return d.keys().hasOnly(['id','reference','studentNumber','campus','category','priority','status',
        'subject','description','location','assignedTo','assignedToName','createdBy','createdAt','updatedAt','deleted','serverUpdatedAt'])
        && d.id == id && text(d.reference, 5, 50)
        && text(d.studentNumber, 1, 20) && d.studentNumber.matches('[A-Za-z0-9-]+')
        && text(d.campus, 1, 100)
        && d.category in ['wifi','account','hardware','software','email','lms','printing','other']
        && d.priority in ['low','medium','high','urgent']
        && d.status in ['open','in_progress','awaiting_student','resolved','closed']
        && text(d.subject, 5, 100) && text(d.description, 1, 5000)
        && optionalText(d, 'location', 200) && optionalText(d, 'assignedTo', 128)
        && optionalText(d, 'assignedToName', 100)
        && d.createdAt is number && d.updatedAt is number
        && d.get('deleted', false) is bool && d.serverUpdatedAt == request.time;
    }
    match /users/{uid} {
      function self() { return institutional() && request.auth.uid == uid; }
      allow read: if self() || support();
      allow create, update: if self()
        && request.resource.data.keys().hasOnly(['uid','email','displayName','studentNumber','campus','providerId','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && text(request.resource.data.displayName, 0, 100)
        && optionalText(request.resource.data, 'studentNumber', 20)
        && optionalText(request.resource.data, 'campus', 100)
        && request.resource.data.providerId in ['password','microsoft.com','unknown']
        && request.resource.data.createdAt is number && request.resource.data.updatedAt is number;
      allow delete: if self();
    }
    match /tickets/{ticketId} {
      function owner() { return institutional() && resource.data.createdBy == request.auth.uid; }
      function immutable() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.reference == resource.data.reference
          && request.resource.data.createdAt == resource.data.createdAt;
      }
      function studentTransition() {
        return request.resource.data.status == resource.data.status
          || (resource.data.status == 'resolved' && request.resource.data.status in ['open','closed'])
          || (resource.data.status == 'closed' && request.resource.data.status == 'open');
      }
      // Creators check for a committed retry before uploading a new UUID.
      // Missing documents contain no data; existing documents still require ownership.
      allow get: if owner() || support() || (institutional()
        && !exists(/databases/$(database)/documents/tickets/$(ticketId)));
      allow list: if owner() || support();
      allow create: if institutional() && validTicket(request.resource.data, ticketId)
        && request.resource.data.createdBy == request.auth.uid
        && (support() || (request.resource.data.status == 'open'
          && request.resource.data.get('assignedTo', null) == null
          && request.resource.data.get('assignedToName', null) == null));
      allow update: if validTicket(request.resource.data, ticketId) && immutable()
        && (!resource.data.get('deleted', false) || request.resource.data.get('deleted', false))
        && (support() || (owner() && studentTransition()
          && request.resource.data.get('assignedTo', null) == resource.data.get('assignedTo', null)
          && request.resource.data.get('assignedToName', null) == resource.data.get('assignedToName', null)));
      // Tombstones propagate deletions to offline devices; records stay available for audit.
      allow delete: if false;
      match /comments/{commentId} {
        function parent() { return getAfter(/databases/$(database)/documents/tickets/$(ticketId)).data; }
        function canAccess() { return institutional() && (support() || parent().createdBy == request.auth.uid); }
        allow read: if institutional() && (support() ||
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid);
        allow create: if canAccess() && !parent().get('deleted', false)
          && !(parent().status in ['resolved','closed'])
          && request.resource.data.keys().hasOnly(['id','ticketId','authorId','authorName','fromSupport','body','createdAt'])
          && request.resource.data.id == commentId && request.resource.data.ticketId == ticketId
          && request.resource.data.authorId == request.auth.uid
          && text(request.resource.data.authorName, 1, 100)
          && text(request.resource.data.body, 1, 4000)
          && request.resource.data.createdAt is number
          && request.resource.data.fromSupport is bool
          && (request.resource.data.fromSupport == false || support());
        // An identical retry is safe after a crash between server commit and local acknowledgement.
        allow update: if canAccess() && resource.data.authorId == request.auth.uid
          && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
  }
}
